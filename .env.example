# MailRecon Environment Configuration

# Database (PostgreSQL)
POSTGRES_USER=mailrecon
POSTGRES_PASSWORD=mailrecon
POSTGRES_DB=mailrecon
DATABASE_URL=postgresql+asyncpg://mailrecon:mailrecon@postgres:5432/mailrecon

# Message Queue (Redis & RQ)
REDIS_URL=redis://redis:6379/0

# File Storage
STORAGE_ROOT=/data/evidence

# Security & Authentication
SECRET_KEY=dev-secret-key-change-in-production-mailrecon-2026
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# API & Frontend Integration
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI Enrichment Provider (mock | gemini)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
