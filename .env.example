# Database
DATABASE_URL=postgresql+asyncpg://mailrecon:mailrecon@postgres:5432/mailrecon
POSTGRES_USER=mailrecon
POSTGRES_PASSWORD=mailrecon
POSTGRES_DB=mailrecon

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Storage
STORAGE_ROOT=/data/evidence

# CORS
CORS_ORIGINS=http://localhost:3000

# API
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI Provider (mock | gemini)
AI_PROVIDER=mock
GEMINI_API_KEY=

# Limits
MAX_UPLOAD_BYTES=26214400
MAX_MIME_DEPTH=10
MAX_IMAGE_DECODE_BYTES=10485760
